# Copy to .env for local dev; set these as the host's env vars in production.
# NEVER commit real secrets — .env is gitignored.

# Where the runtime models live (the Dockerfile sets this; keep as-is in the container).
MODELS_DIR=models

# Port the server listens on. Railway/Render inject their own $PORT — leave unset there.
# PORT=8000

# --- Database (when the store moves off in-memory to Postgres/Supabase) ---
# From Supabase → Project Settings → Database. Use the Mumbai (ap-south-1) region.
# DATABASE_URL=postgresql://user:password@host:5432/postgres

# --- Garment catalog (the /closet 'supply' side; app/catalog.py) ---
# Reads garments from Supabase when both are set, else serves a built-in sample.
# Use the ANON (public) key here on Service A — read-only. The ingestion script
# (bench/ingest_garments.py) needs the SERVICE ROLE key instead, to write.
# Schema: docs/catalog_schema.sql. Bucket: a PUBLIC bucket named 'garments'.
# KREY_SUPABASE_URL=https://yourproject.supabase.co
# KREY_SUPABASE_KEY=eyJ...ANON_PUBLIC_KEY...

# --- Fit Conversation LLM (Anthropic Claude) — only when the live extractor is wired ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- Hair-texture model (optional; train/infer.py wired via app/face.py) ---
# Unset = heuristic stub / texture "unavailable" (recognition renormalises). Point at a
# trained checkpoint to enable the learned reader. See docs/hair_texture_plan.md + train/.
# KREY_HAIR_TEXTURE_MODEL=models/hair_texture/model.pt

# --- Alpha feedback by email (optional; app/notify.py) ---
# PREFERRED on hosts that block SMTP ports (Railway blocks 25/465/587): Resend HTTP API
# over 443. Create a free Resend account with the recipient's Gmail, make an API key.
# With the default sender (onboarding@resend.dev) NO domain verification is needed, but it
# can only deliver to the Resend account's own email — perfect for team feedback.
# KREY_RESEND_API_KEY=re_xxxxxxxx
# KREY_RESEND_FROM=Krey Alpha <onboarding@resend.dev>   # optional; default shown
# KREY_FEEDBACK_EMAIL_TO=kreyindia@gmail.com            # required for either transport
#
# LEGACY SMTP (works only where outbound SMTP ports are open — NOT on Railway):
# Gmail: turn on 2-Step Verification, then create an App Password (NOT your normal password).
# KREY_SMTP_HOST=smtp.gmail.com
# KREY_SMTP_PORT=587
# KREY_SMTP_USER=kreyindia@gmail.com
# KREY_SMTP_PASS=your-16-char-app-password
# KREY_FEEDBACK_EMAIL_FROM=kreyindia@gmail.com   # optional; defaults to KREY_SMTP_USER

# --- Durable feedback log (optional; opens a GitHub Issue per /feedback ticket) ---
# A running server can't commit files to git, so the durable, readable record is Issues.
# Create a fine-grained PAT with Issues:Read+Write on the repo below, set both vars.
# KREY_GITHUB_TOKEN=github_pat_xxx
# KREY_GITHUB_REPO=zkrey/krey_avatar_prateek

# --- Performance / memory (small hosts, e.g. Railway 1GB) ---
# KREY_FACE_MODEL=buffalo_s     # buffalo_s fits 1GB; buffalo_l = better accuracy, needs >2GB
# KREY_DET_SIZE=640             # face detection input size (smaller = less memory)
# KREY_MAX_IMAGE_PX=1600        # longest edge photos are downscaled to before the CV stack
# KREY_ATTR_FRAMES=3            # how many best frames get the (heavy) attribute read
# KREY_POSE_MODEL=lite          # pose model: lite fits 1GB; heavy = more accurate, needs more RAM

# --- Instagram source (Business/Creator, after Meta App Review) ---
# Provided per-request by the client, not stored here.
